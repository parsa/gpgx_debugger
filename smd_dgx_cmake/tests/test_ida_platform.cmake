# The ARM SDK uses a different va_list convention from the x64 SDK.
set(WIN32 FALSE)
set(APPLE TRUE)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(IDA_SDK_DIR "/sdk")
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ida_platform.cmake")
if (NOT IDA_PROCESSOR_DEF STREQUAL "__ARM__")
  message(FATAL_ERROR "arm64 IDA modules must use __ARM__, got '${IDA_PROCESSOR_DEF}'")
endif()
if (NOT IDA_MODULE_SUFFIX STREQUAL ".dylib")
  message(FATAL_ERROR "macOS IDA modules must use .dylib")
endif()

set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_OSX_ARCHITECTURES x86_64)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ida_platform.cmake")
if (NOT IDA_PROCESSOR_DEF STREQUAL "__X64__")
  message(FATAL_ERROR "x64 IDA modules must use __X64__, got '${IDA_PROCESSOR_DEF}'")
endif()
